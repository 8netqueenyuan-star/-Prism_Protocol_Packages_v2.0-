{
  "name": "business_adapter",
  "version": "2.0",
  "purpose": "将 OEIA 内核用于经营、资本与组织决策。",
  "intake_fields": ["目标", "决策期限", "现金流", "团队能力", "客户信号", "竞争环境", "不可逆风险"],
  "decision_lenses": ["单位经济", "现金流韧性", "客户价值", "组织承载", "品牌信任", "退出与停止条件"],
  "required_outputs": ["选项比较", "关键假设", "90 天最小试验", "指标与停止条件", "复盘日期"],
  "guardrails": ["不承诺收益", "不把预测写成事实", "涉及融资、税务或证券时建议专业复核"]
}
