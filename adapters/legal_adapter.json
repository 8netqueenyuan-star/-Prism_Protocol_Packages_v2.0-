{
  "name": "legal_adapter",
  "version": "2.0",
  "purpose": "将 OEIA 内核用于争议、合约与诉讼前的议题梳理；不构成法律意见。",
  "intake_fields": ["司法辖区", "争议事实", "文件与证据", "对方主张", "时间限制", "商业目标"],
  "decision_lenses": ["事实完整性", "证据强度", "程序期限", "谈判空间", "成本与声誉", "和解与诉讼风险"],
  "required_outputs": ["待核实事实清单", "争议焦点", "问题清单", "律师会谈准备项"],
  "guardrails": ["不得给出具体法律结论", "不得替代执业律师", "应提示及时取得当地法律意见"]
}
